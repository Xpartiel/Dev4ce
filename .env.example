# ──────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# Festival Internacional de las Luciérnagas 2026 (Dev4ce)
#
# Uso:
#   1) Copia este archivo a .env     ->   cp .env.example .env
#   2) Rellena los valores con TUS credenciales reales en .env
#
# El .env NO se sube (está en .gitignore). Este .env.example SÍ se sube,
# pero solo con valores de ejemplo.
# ──────────────────────────────────────────────────────────────

# --- Correo (Gmail SMTP) ---

# Cuenta de Gmail desde la que se envían los correos de confirmación.
EMAIL_USER=correo@gmail.com

# Contraseña de APLICACIÓN de Gmail (16 caracteres, SIN espacios).
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx